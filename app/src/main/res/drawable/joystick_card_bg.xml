<?xml version="1.0" encoding="utf-8"?>
<!--
    res/drawable/joystick_card_bg.xml
    Joystick kartı için yarı saydam arka plan.
    Proje renk paleti: #506B70 (deniz mavisi)
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Arka plan rengi: tamamen saydam -->
    <solid android:color="#00000000" />

    <!-- Yuvarlak köşe -->
    <corners android:radius="16dp" />

    <!-- İnce kenarlık -->
    <stroke
        android:width="1dp"
        android:color="#70506B70" />

</shape>